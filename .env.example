# Proveedor del modelo: google_genai (principal) | openrouter (respaldo)
MODEL_PROVIDER=google_genai
MODEL_NAME=gemini-3.5-flash-lite
# Necesario en Gemini 3+ para que devuelva el razonamiento (low | medium | high).
# Con gemini-2.5-flash, dejalo comentado.
THINKING_LEVEL=medium

# --- Google Gemini ---
# Clave desde https://aistudio.google.com/apikey
# Obligatoria siempre: también se usa para los embeddings del RAG
GOOGLE_API_KEY=tu_api_key_aqui

# --- Tavily (web_search sobre dominios oficiales) ---
# Clave desde https://app.tavily.com
TAVILY_API_KEY=tu_api_key_aqui

# --- OpenRouter (opcional, solo si MODEL_PROVIDER=openrouter) ---
# MODEL_NAME es el slug del modelo, por ejemplo: google/gemini-2.5-flash
# OPENROUTER_API_KEY=tu_api_key_aqui

# --- Tectonic (opcional): ruta al ejecutable si no está en el PATH ---
# TECTONIC_PATH=C:\herramientas\tectonic.exe
